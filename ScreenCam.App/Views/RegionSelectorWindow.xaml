<Window x:Class="ScreenCam.App.Views.RegionSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenCam — Select Screen Area"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual" SizeToContent="Manual"
        FocusManager.FocusedElement="{Binding ElementName=Surface}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <!-- Nearly transparent (alpha 1) so the whole overlay receives mouse input. -->
        <Canvas x:Name="Surface" Background="#01000000" Focusable="True"
                MouseLeftButtonDown="Surface_MouseLeftButtonDown"
                MouseMove="Surface_MouseMove"
                MouseLeftButtonUp="Surface_MouseLeftButtonUp">

            <Path x:Name="Dim" Fill="#8C000000" IsHitTestVisible="False">
                <Path.Data>
                    <GeometryGroup FillRule="EvenOdd">
                        <RectangleGeometry x:Name="DimOuter" />
                        <RectangleGeometry x:Name="DimHole" />
                    </GeometryGroup>
                </Path.Data>
            </Path>

            <Rectangle x:Name="SelectionBorder" Stroke="#3B82F6" StrokeThickness="2"
                       Fill="Transparent" IsHitTestVisible="False" Visibility="Collapsed" />

            <Border x:Name="SizeLabel" Background="#E6111827" CornerRadius="4" Padding="6,2"
                    IsHitTestVisible="False" Visibility="Collapsed">
                <TextBlock x:Name="SizeText" Foreground="White" FontSize="12" FontFamily="Consolas" />
            </Border>

            <Border x:Name="Toolbar" Background="#F2111827" CornerRadius="8" Padding="6" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ConfirmButton" Content="✔  Use this area" Style="{StaticResource RoundedButton}"
                            Background="{StaticResource SuccessBrush}" Margin="0,0,6,0" Padding="12,6" Click="Confirm_Click" />
                    <Button Content="Whole display" Style="{StaticResource RoundedButton}"
                            Background="#374151" Margin="0,0,6,0" Padding="12,6" Click="WholeDisplay_Click" />
                    <Button Content="Cancel" Style="{StaticResource RoundedButton}"
                            Background="#4B5563" Padding="12,6" Click="Cancel_Click" />
                </StackPanel>
            </Border>
        </Canvas>

        <Border x:Name="Hint" Background="#E6111827" CornerRadius="8" Padding="14,8"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" IsHitTestVisible="False">
            <StackPanel>
                <TextBlock x:Name="MonitorText" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Foreground="#D1D5DB" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"
                           Text="Drag to select · drag inside to move · drag the handles to resize · hold Shift to keep the camera aspect ratio" />
                <TextBlock Foreground="#D1D5DB" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0"
                           Text="Enter or double-click = confirm · Esc = cancel" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
