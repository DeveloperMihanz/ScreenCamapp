<Window x:Class="ScreenCam.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenCam Settings" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}" FontFamily="Segoe UI" FontSize="13" Foreground="#111827">
    <StackPanel Margin="20">
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="CAPTURE" />
                <CheckBox x:Name="ShowCursorBox" Content="Show the mouse cursor in the camera image" />
                <CheckBox x:Name="HideBorderBox" Content="Hide the Windows capture border (Windows 11, when permitted)" />
                <TextBlock Text="How the selected area fits the camera frame" Margin="0,10,0,4" />
                <ComboBox x:Name="ScaleModeBox" DisplayMemberPath="Label" SelectedValuePath="Mode" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="PREVIEW" />
                <CheckBox x:Name="PreviewBox" Content="Show the live preview (turn off to save CPU)" />
                <TextBlock Text="Preview quality" Margin="0,8,0,4" />
                <ComboBox x:Name="PreviewSizeBox" DisplayMemberPath="Label" SelectedValuePath="Width" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="STARTUP" />
                <CheckBox x:Name="AutoStartBox" Content="Start the virtual camera automatically when ScreenCam opens" />
                <TextBlock Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0"
                           Text="The camera status always reflects whether the camera component really started." />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="DIAGNOSTICS" />
                <TextBlock x:Name="DiagnosticsText" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Open settings folder" Style="{StaticResource SecondaryButton}" Padding="10,5" Click="OpenSettingsFolder_Click" />
                    <Button Content="Open log folder" Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="8,0,0,0" Click="OpenLogFolder_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" MinWidth="90" IsCancel="True" />
            <Button Content="Save" Style="{StaticResource RoundedButton}" MinWidth="90" Margin="8,0,0,0" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
