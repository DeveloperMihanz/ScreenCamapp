// Version resource for ScreenCam.VirtualCameraSource.dll
#include <winver.h>
#include "Version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION SCREENCAM_VERSION_MAJOR,SCREENCAM_VERSION_MINOR,SCREENCAM_VERSION_PATCH,0
 PRODUCTVERSION SCREENCAM_VERSION_MAJOR,SCREENCAM_VERSION_MINOR,SCREENCAM_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ScreenCam"
            VALUE "FileDescription", "ScreenCam Virtual Camera media source (Frame Server COM component)"
            VALUE "FileVersion", SCREENCAM_VERSION_STRING
            VALUE "InternalName", "ScreenCam.VirtualCameraSource.dll"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "ScreenCam.VirtualCameraSource.dll"
            VALUE "ProductName", "ScreenCam Virtual Camera"
            VALUE "ProductVersion", SCREENCAM_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
